{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ansible": {
    "managerFilePatterns": ["/(^|/)tasks/[^/]+\\.ya?ml$", "/vars\\.ya?ml$"]
  },
  "ansible-galaxy": {
    "managerFilePatterns": ["/requirements\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Avoid duplicate helm updates: the custom regex manager already tracks the azure/setup-helm version input via the inline renovate comment",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["helm"],
      "enabled": false
    },
    {
      "description": "Host GPU driver: 2026.09.16 is the known regression. A bump reboots the Proxmox host and may need a newer kernel (#312 moved to 2026.11.05 on 7.0), so new releases wait on the Dependency Dashboard; change the driver, i915_sriov_pinned_kernel and the host CCS param together by hand in a maintenance window",
      "matchPackageNames": ["strongtz/i915-sriov-dkms"],
      "allowedVersions": "!/^v?2026\\.09\\.16$/",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "ansible-core 2.21 (ansible 14) fails to import on Python 3.15 (dataclasses._is_type removed, #291); lift together with the ansible 15 / ansible-core 2.22 upgrade",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "description": "Update Ansible variables and GitHub Actions inputs",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)group_vars/.*/.*\\.ya?ml$/",
        "/(^|/)tasks/[^/]+\\.ya?ml$/",
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+registryUrl=(?<registryUrl>.*?))?\\s+.*?(?:version|[a-z0-9_]+_version):\\s*['\"]?(?<currentValue>.*?)['\"]?\\s"
      ]
    },
    {
      "description": "Update i915-sriov-dkms with loose versioning",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)group_vars/.*/.*\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>strongtz/i915-sriov-dkms)\\s+.*?i915_sriov_version:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}
