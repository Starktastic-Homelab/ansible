{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ansible": {
    "managerFilePatterns": ["/(^|/)tasks/[^/]+\\.ya?ml$", "/vars\\.ya?ml$"]
  },
  "customManagers": [
    {
      "description": "Update Ansible variables with Renovate comments",
      "customType": "regex",
      "fileMatch": ["(^|/)group_vars/all/vars\\.ya?ml$", "(^|/)tasks/[^/]+\\.ya?ml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+registryUrl=(?<registryUrl>.*?))?\\s+.*?[a-z0-9_]+_version:\\s*\"?(?<currentValue>.*?)\"?\\s"
      ]
    }
  ]
}
