# Managed by ansible (proxmox_backup).
[Unit]
Description=Homelab backup: %i
After=network-online.target usbbk-import.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-backup %i
# Stops a run hung on NFS or SFTP before the next one is due. A first upload that needs longer runs under
# systemd-run instead (see the backup runbook).
TimeoutStartSec=23h
Nice=10
IOSchedulingClass=idle
