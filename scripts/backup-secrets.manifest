# backup-secrets.manifest — paths (never contents) of the git-ignored secrets
# to back up. One path per line; '#' starts a comment; blank lines ignored;
# globs allowed. Paths resolve against HOMELAB_ROOT (default: the homelab root,
# i.e. the parent of the ansible repo). A leading ~ expands to your home dir.

id_rsa                       # SSH key to the nodes — enables get-kubeconfig.sh
ansible/.vault_pass          # CROWN JEWEL: unlocks the sealed-secrets master key + all vault content
terraform/terraform.tfvars   # provider + S3 backend credentials

# ~/.kube/config             # NOT needed — regenerate via get-kubeconfig.sh once id_rsa is restored
# ~/.ssh/id_rsa              # uncomment if a separate key is needed for Proxmox host access
# packer/*.local.pkrvars.hcl # uncomment if you add local packer secrets
