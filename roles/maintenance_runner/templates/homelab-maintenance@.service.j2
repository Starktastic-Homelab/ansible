[Unit]
Description=Read-only homelab maintenance request %i

[Service]
Type=exec
ExecStart={{ maintenance_runner_executor_python }} -B -E -s {{ maintenance_runner_executor_manifest | dirname }}/ansible/scripts/maintenance_executor.py --manifest {{ maintenance_runner_executor_manifest }} run %i
Restart=no
KillMode=control-group
TimeoutStopSec=30s
RuntimeMaxSec=3600
UMask=0077
NoNewPrivileges=yes
StandardOutput=null
StandardError=null
# No [Install] section: no boot activation or automatic replay.
